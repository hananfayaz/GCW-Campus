<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grey_color"
    tools:context=".activities.ProfileActivity">

    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/image_description"
        android:scaleType="fitXY"
        android:src="@drawable/profile_vector"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-70dp"
        android:contentDescription="@string/image_description"
        android:src="@drawable/profile_card"
        app:layout_constraintEnd_toEndOf="@+id/imageView4"
        app:layout_constraintStart_toStartOf="@+id/imageView4"
        app:layout_constraintTop_toBottomOf="@+id/imageView4" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/profile_image"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:contentDescription="@string/image_description"
        android:src="@drawable/user"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/roundedImageView"
        app:layout_constraintBottom_toBottomOf="@+id/imageView5"
        app:layout_constraintEnd_toEndOf="@+id/imageView5"
        app:layout_constraintStart_toStartOf="@+id/imageView5"
        app:layout_constraintTop_toTopOf="@+id/imageView5"
        app:layout_constraintVertical_bias="0.10" />

    <TextView
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/titillium_web_regular"
        android:textColor="@color/black_text"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@+id/imageView5"
        app:layout_constraintEnd_toEndOf="@+id/imageView5"
        app:layout_constraintStart_toStartOf="@+id/imageView5"
        app:layout_constraintTop_toBottomOf="@+id/profile_image"/>

    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="26dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/imageView5"
        app:layout_constraintStart_toStartOf="@+id/imageView5"
        app:layout_constraintTop_toBottomOf="@+id/imageView5">

        <TextView
            android:id="@+id/textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/titillium_web_regular"
            android:text="@string/phone_number"
            android:textColor="@color/black_text"
            android:textSize="20sp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"/>

        <TextView
            android:id="@+id/textview2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/titillium_web_regular"
            android:text="@string/address"
            android:textColor="@color/black_text"
            android:textSize="20sp"
            android:layout_below="@+id/textview"
            android:layout_alignParentStart="true"/>

        <TextView
            android:id="@+id/textview3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/titillium_web_regular"
            android:text="@string/d_o_b"
            android:textColor="@color/black_text"
            android:textSize="20sp"
            android:layout_below="@+id/textview2"/>

        <TextView
            android:id="@+id/textview4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/titillium_web_regular"
            android:text="@string/email"
            android:textColor="@color/black_text"
            android:textSize="20sp"
            android:layout_below="@+id/textview3"/>

        <TextView
            android:id="@+id/textview5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/titillium_web_regular"
            android:text="@string/gender"
            android:textColor="@color/black_text"
            android:textSize="20sp"
            android:layout_below="@+id/textview4"/>

        <TextView
            android:id="@+id/sem_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/titillium_web_regular"
            android:text="@string/semester"
            android:textColor="@color/black_text"
            android:textSize="20sp"
            android:layout_below="@+id/textview5"/>

        <TextView
            android:id="@+id/roll_no_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/titillium_web_regular"
            android:text="@string/roll_no"
            android:textColor="@color/black_text"
            android:textSize="20sp"
            android:layout_below="@+id/sem_textview"/>

        <TextView
            android:id="@+id/reg_no_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/titillium_web_regular"
            android:text="@string/reg_no"
            android:textColor="@color/black_text"
            android:textSize="20sp"
            android:layout_below="@+id/roll_no_textview"/>

        <TextView
            android:id="@+id/user_ph_no"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/textview"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_alignBottom="@+id/textview"
            android:textSize="16sp"
            android:gravity="center"
            android:textColor="@color/black_text"
            android:fontFamily="@font/titillium_web_regular"/>

        <TextView
            android:id="@+id/user_address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/textview2"
            android:layout_alignTop="@+id/textview2"
            android:layout_alignParentEnd="true"
            android:layout_alignBottom="@+id/textview2"
            android:textSize="16sp"
            android:gravity="center"
            android:textColor="@color/black_text"
            android:fontFamily="@font/titillium_web_regular"/>

        <TextView
            android:id="@+id/user_dob"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/textview3"
            android:layout_alignTop="@+id/textview3"
            android:layout_alignParentEnd="true"
            android:layout_alignBottom="@+id/textview3"
            android:textSize="16sp"
            android:gravity="center"
            android:textColor="@color/black_text"
            android:fontFamily="@font/titillium_web_regular"/>

        <TextView
            android:id="@+id/user_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/textview4"
            android:layout_alignTop="@+id/textview4"
            android:layout_alignParentEnd="true"
            android:layout_alignBottom="@+id/textview4"
            android:textSize="16sp"
            android:gravity="center"
            android:textColor="@color/black_text"
            android:fontFamily="@font/titillium_web_regular"/>

        <TextView
            android:id="@+id/user_gender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/textview5"
            android:layout_alignTop="@+id/textview5"
            android:layout_alignParentEnd="true"
            android:layout_alignBottom="@+id/textview5"
            android:textSize="16sp"
            android:gravity="center"
            android:textColor="@color/black_text"
            android:fontFamily="@font/titillium_web_regular"/>

        <TextView
            android:id="@+id/user_sem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/sem_textview"
            android:layout_alignTop="@+id/sem_textview"
            android:layout_alignParentEnd="true"
            android:layout_alignBottom="@+id/sem_textview"
            android:textSize="16sp"
            android:gravity="center"
            android:textColor="@color/black_text"
            android:fontFamily="@font/titillium_web_regular"/>

        <TextView
            android:id="@+id/user_roll_no"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/roll_no_textview"
            android:layout_alignTop="@+id/roll_no_textview"
            android:layout_alignParentEnd="true"
            android:layout_alignBottom="@+id/roll_no_textview"
            android:textSize="16sp"
            android:gravity="center"
            android:textColor="@color/black_text"
            android:fontFamily="@font/titillium_web_regular"/>

        <TextView
            android:id="@+id/user_reg_no"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/reg_no_textview"
            android:layout_alignTop="@+id/reg_no_textview"
            android:layout_alignParentEnd="true"
            android:layout_alignBottom="@+id/reg_no_textview"
            android:textSize="16sp"
            android:gravity="center"
            android:textColor="@color/black_text"
            android:fontFamily="@font/titillium_web_regular"/>

        <TextView
            android:id="@+id/dep_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/titillium_web_regular"
            android:text="@string/department"
            android:textColor="@color/black_text"
            android:textSize="20sp"
            android:layout_below="@+id/reg_no_textview"/>

        <TextView
            android:id="@+id/user_department"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/dep_textview"
            android:layout_alignTop="@+id/dep_textview"
            android:layout_alignParentEnd="true"
            android:layout_alignBottom="@+id/dep_textview"
            android:textSize="16sp"
            android:gravity="center"
            android:maxLines="3"
            android:textColor="@color/black_text"
            android:fontFamily="@font/titillium_web_regular"/>

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>